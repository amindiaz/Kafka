# ── Copiar a .env.aws (NO subir a git). La plantilla de CloudFormation lo genera sola
#    en la instancia; este archivo sirve para repetir el despliegue a mano. ──────────────

# Dominio base: <IP-con-guiones>.nip.io  (ej. 34-123-45-67.nip.io) o un dominio propio
DOMAIN=34-123-45-67.nip.io

# Salidas (Outputs) de la pila de CloudFormation
PUBLIC_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
AWS_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=donaciones-123456789012.auth.us-east-1.amazoncognito.com

# Contraseñas: generar cada una con  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
DB_USER=donaciones_user
DB_PASS=
RABBITMQ_USER=donaciones_mq
RABBITMQ_PASS=
RABBITMQ_ERLANG_COOKIE=
JWT_SECRET=

FRONTEND_CONTEXT=../donaciones-frontend
