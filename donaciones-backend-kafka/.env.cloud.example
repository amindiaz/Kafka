# ── Copiar a .env.cloud (NO subir a git) y completar ─────────────────────────────
# Dominio base. Necesitas los registros DNS app.<DOMAIN>, api.<DOMAIN>, auth.<DOMAIN>
# y rabbit.<DOMAIN> apuntando a la IP pública de la VM. Sin dominio propio se puede
# usar nip.io, por ejemplo DOMAIN=34-123-45-67.nip.io  (resuelve app.34-123-45-67.nip.io → 34.123.45.67)
DOMAIN=midominio.example.com

# Generar contraseñas distintas y largas, por ejemplo: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
DB_USER=donaciones_user
DB_PASS=
RABBITMQ_USER=donaciones_mq
RABBITMQ_PASS=
RABBITMQ_ERLANG_COOKIE=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# URLs públicas que ve el navegador (deben coincidir con DOMAIN)
PUBLIC_API_URL=https://api.midominio.example.com
PUBLIC_OIDC_ISSUER=https://auth.midominio.example.com/realms/donaciones
PUBLIC_FRONTEND_URL=https://app.midominio.example.com
FRONTEND_CONTEXT=../donaciones-frontend
JWT_SECRET=
