{
  "realm": "donaciones",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "OPERADOR"
      },
      {
        "name": "USER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "donaciones-frontend",
      "name": "Frontend Angular",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "${FRONTEND_URL}/*"
      ],
      "webOrigins": [
        "${FRONTEND_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_URL}/*"
      }
    }
  ],
  "users": [
