# ── Copiar a .env y ajustar valores para producción ──────────────────────────
# docker-compose lee automáticamente el archivo .env en el mismo directorio.

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=cambia_esto_en_produccion
DB_USER=donaciones_user
DB_PASS=cambia_esto_en_produccion

# JWT — debe ser una cadena aleatoria de al menos 32 caracteres (256 bits)
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_una_clave_segura_generada_aleatoriamente_minimo_256bits
JWT_EXPIRATION=86400000

# ── RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_USER=donaciones_mq
RABBITMQ_PASS=donaciones_mq_pass
RABBITMQ_ERLANG_COOKIE=donaciones-cluster-cookie

# ── Frontend (URLs públicas que usa el navegador; en la nube cambiar localhost por la IP/dominio) ──
FRONTEND_CONTEXT=../donaciones-frontend
PUBLIC_API_URL=http://localhost:8080
PUBLIC_OIDC_ISSUER=http://localhost:9090/realms/donaciones
